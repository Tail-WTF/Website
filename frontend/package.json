{
  "name": "tail.wtf-website",
  "version": "0.1.0",
  "author": "Tail.WTF Contributors <hello@tail.wtf>",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/csp-headers.mjs",
    "preview": "vite preview",
    "e2e:server": "pnpm run build && pnpm --dir ../api run build:rules && pnpm --dir ../api exec wrangler dev --port 4173",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "26.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.1.17",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  }
}
